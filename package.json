{
  "name": "dsh-multi-ai-discussion",
  "version": "1.0.1",
  "description": "多 AI 讨论：让多个大模型围绕同一需求各自作答、互相点评，再汇总成一份更完整可靠的答案。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "preview/*.png"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "multi-model",
    "debate",
    "consensus"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
